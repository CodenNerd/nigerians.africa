# Optional: OpenAI-compatible API for Ask AI. Without this, Ask returns structured retrieval only.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: Supabase (local or cloud). Demo runs on seed data without these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required for Follow updates (subscriptions, events, deliveries). Local Supabase default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Follow updates by email (Resend). Without RESEND_API_KEY, follows still save; mail is skipped.
RESEND_API_KEY=
# From address. Defaults to onboarding@resend.dev when unset.
EMAIL_FROM=
# Absolute site URL for unsubscribe / entity links in mail (falls back to VERCEL_URL / localhost).
FOLLOW_APP_URL=http://localhost:3000
# Protects POST /api/cron/follow-digest (Authorization: Bearer …). Optional in local/dev.
CRON_SECRET=

# Demo auth (cookie session). Change in production.
AUTH_SECRET=nigeria-for-nigerians-demo-secret-change-me
